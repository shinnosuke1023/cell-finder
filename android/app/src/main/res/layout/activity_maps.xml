<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MapsActivity">

    <!-- Control Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@android:color/white"
        android:elevation="4dp">

        <Spinner
            android:id="@+id/cellIdSpinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:spinnerMode="dropdown" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/btn_refresh"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/stopServicesButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/btn_stop"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:backgroundTint="@color/stop_button_background"
            android:textColor="@color/service_button_text" />

    </LinearLayout>
    
    <!-- Current Cell Info Panel -->
    <TextView
        android:id="@+id/currentCellInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#EE000000"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/no_cell_info"
        android:visibility="gone" />

    <!-- Map area with floating follow button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/followLocationButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_my_location_outline"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:elevation="6dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:contentDescription="@string/btn_follow_off_description" />

    </FrameLayout>

</LinearLayout>